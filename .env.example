# Этап 2 — Supabase Auth (Яндекс ID) и синхронизация
# Публичные значения: anon key можно класть в сборку, service role — только в секреты Edge Function.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Нужен функции yandex-oauth и настройке OAuth-приложения Яндекса.
VITE_YANDEX_CLIENT_ID=

# Этап 3 — бэкап на Google Drive (отдельный OAuth, scope drive.appdata)
VITE_GOOGLE_CLIENT_ID=
